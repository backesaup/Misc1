{
  "name": "blocky",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-textures.mjs --soft && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:e2e:dev": "ALLOW_TTS_FALLBACK=1 playwright test --trace off",
    "check:audio": "node scripts/check-audio.mjs",
    "audio:lines": "node scripts/list-lines.ts",
    "textures:fetch": "node scripts/fetch-textures.mjs",
    "icons": "node scripts/make-icons.mjs",
    "assets:index": "node scripts/build-asset-index.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "predeploy": "npm run test && npm run check:audio && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders-react": "^0.0.82",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "liquid-glass-js": "^0.1.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "minecraft-data": "^3.119.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "three": "$three"
  }
}
